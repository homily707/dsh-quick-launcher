{
  "name": "@homily/dsh-quick-launcher",
  "version": "0.3.1",
  "private": false,
  "type": "module",
  "description": "A quick launcher beside the DSH composer for commands, prompt snippets and skills.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homily707/dsh-quick-launcher.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
